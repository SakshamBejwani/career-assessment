# ─────────────────────────────────────────────────────────────────────────────
# Psychology-Based Career Assessment — environment configuration
# Copy to `.env` for local development. On Vercel / Hostinger set these in the
# hosting panel instead. Never commit real values.
# Full reference: docs/DEPLOYMENT.md and spec §14.
# ─────────────────────────────────────────────────────────────────────────────

# development | staging | production
APP_ENV=development
APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# postgresql (recommended: Neon, Supabase, VPS) or mysql (Hostinger MySQL)
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://app:app@localhost:5432/pbca_dev
# Direct (non-pooled) URL used only for migrations on Neon/Supabase. Optional.
DATABASE_URL_UNPOOLED=
# Connections per server instance (keep small on serverless and shared MySQL hosting).
DATABASE_POOL_MAX=5

# ── Secrets (generate with: openssl rand -base64 48) ─────────────────────────
SESSION_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
REPORT_LINK_SECRET=replace-with-another-32-random-characters-xxxxxxx
CRON_SECRET=replace-with-a-random-token
REPORT_LINK_TTL_HOURS=168

# ── Assessments ──────────────────────────────────────────────────────────────
ENABLED_ASSESSMENTS=mbti_personality,holland_riasec,vark_learning_styles
# In production, unapproved assessment versions are blocked unless this is true.
# When true, pages and PDFs carry a visible "Preview — pending client validation" marker.
ALLOW_UNAPPROVED_ASSESSMENTS=false

# ── Payments ─────────────────────────────────────────────────────────────────
# razorpay | mock   (mock is refused when APP_ENV=production)
PAYMENT_PROVIDER=mock
# post_completion | upfront   (per-module override: PAYMENT_WORKFLOW_<MODULE_ID>)
PAYMENT_WORKFLOW=post_completion
# PAYMENT_WORKFLOW_HOLLAND_RIASEC=upfront
CURRENCY=INR
# Prices in minor units (paise). PLACEHOLDER VALUES — confirm with the client.
PRICE_MBTI_PERSONALITY=49900
PRICE_HOLLAND_RIASEC=49900
PRICE_VARK_LEARNING_STYLES=29900

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email ────────────────────────────────────────────────────────────────────
# smtp | log | none   (log prints a redacted summary instead of sending)
EMAIL_PROVIDER=log
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Psychology-Based Career Assessment <reports@example.com>"
EMAIL_REPLY_TO=
EMAIL_ATTACH_PDF=true

# ── WhatsApp (Meta WhatsApp Cloud API) ───────────────────────────────────────
# meta | log | none
WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Approved template with two body parameters: {{1}} first name, {{2}} report link
WHATSAPP_TEMPLATE_NAME=report_ready
WHATSAPP_TEMPLATE_LANG=en
DEFAULT_PHONE_REGION=IN

# ── Owner / host notifications ───────────────────────────────────────────────
OWNER_NOTIFY_EMAILS=
OWNER_NOTIFY_EVENTS=payment_succeeded,scoring_failed,report_generation_failed,report_delivery_failed

# ── Report storage ───────────────────────────────────────────────────────────
# database (works everywhere) | filesystem (VPS / persistent disk) | s3 (S3, R2, B2, MinIO)
REPORT_STORAGE=database
REPORT_STORAGE_DIR=./storage/reports
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated email:hash pairs. Create one with: npm run admin:hash-password -- you@example.com
ADMIN_USERS=

# ── Operations ───────────────────────────────────────────────────────────────
# >0 runs the background job loop inside the server (VPS, Docker, Hostinger). Keep 0 on Vercel.
JOB_WORKER_INTERVAL_MS=0
LOG_LEVEL=info
ERROR_WEBHOOK_URL=
DISPLAY_TIMEZONE=Asia/Kolkata

# ── Branding ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ORG_NAME=Psychology-Based Career Assessment
SUPPORT_EMAIL=support@example.com

# ── Docker Compose only (docker-compose.yml) ─────────────────────────────────
# DOMAIN=assessments.example.com
# POSTGRES_PASSWORD=replace-with-a-strong-password
