{
  "name": "career-assessment-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:prod": "prisma generate && prisma migrate deploy && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "start:prod": "prisma migrate deploy && next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:sync-mysql": "node scripts/sync-mysql-schema.mjs",
    "content:generate": "node scripts/generate-content.mjs",
    "admin:hash-password": "node scripts/hash-password.mjs",
    "jobs:run": "node scripts/run-jobs.mjs"
  },
  "dependencies": {
    "@fontsource/lexend": "5.3.0",
    "@fontsource/lexend-exa": "5.3.0",
    "@fontsource/lexend-mega": "5.3.0",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-pdf/renderer": "4.9.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "aws4fetch": "1.0.20",
    "dotenv": "18.0.7",
    "libphonenumber-js": "1.13.15",
    "next": "16.4.0",
    "nodemailer": "10.1.0",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/smtp-server": "3.5.13",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "smtp-server": "3.19.21",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "@prisma/adapter-mariadb": {
      "mariadb": "3.5.4"
    },
    "mysql2": "3.24.5"
  }
}
